# Nuvio Movies & TV Addon - Environment Variables
# Copy this file to .env and customize as needed

# Server Configuration
PORT=7001
LOG_LEVEL=INFO

# Cache Configuration (seconds)
CACHE_TTL_SEARCH=3600
CACHE_TTL_CATALOG=86400

# Stream Resolution Deadline (seconds) - must be < 10s for Vercel
STREAM_DEADLINE_S=9.5

# Rate Limiting (requests per minute per provider)
RATE_LIMIT_VIDLOVE=30
RATE_LIMIT_VIDROCK=30

# Provider Configuration
# VIDLOVE_API_BASE=https://api.vidlove.cc
# VIDROCK_API_BASE=https://vidrock.net

# Optional: Browser User Agent for CF bypass
# BROWSER_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
# CF_DELAY_MS=300

# Addon Metadata
ADDON_ID=org.nuvio.movies-1080p
ADDON_NAME=Movies & TV 1080p+
VERSION=1.4.0